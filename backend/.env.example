# PostgreSQL (Supabase: Settings > Database > Connection string)
DATABASE_URL="postgresql://postgres:password@localhost:5432/homeee"

JWT_SECRET="change-me-long-random-string"
JWT_REFRESH_SECRET="change-me-other-long-random-string"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="homeee-media"
R2_PUBLIC_BASE_URL="https://media.yourdomain.com"

# Dev mode: OTP luôn là 000000, log ra console thay vì gửi SMS
OTP_DEV_MODE="true"
# Gửi OTP thật (khi OTP_DEV_MODE khác "true"): ưu tiên Zalo ZNS, không được thì SMS eSMS.vn.
# Zalo: OA đã duyệt + template ZNS OTP có tham số `otp`.
ZALO_OA_ACCESS_TOKEN=""
ZALO_ZNS_OTP_TEMPLATE_ID=""
# SMS brandname eSMS.vn
ESMS_API_KEY=""
ESMS_SECRET_KEY=""
ESMS_BRANDNAME=""
PORT=3000

# Google Drive (OAuth "Web application" client) — lưu ảnh/video công trình vào Drive của chủ nhà.
# Tạo tại: Google Cloud Console > APIs & Services > Credentials > Create OAuth client > Web application.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" — key riêng mỗi môi trường.
DRIVE_TOKEN_ENC_KEY=""
# URL https công khai trỏ về route /google-drive/callback của backend này (VD: qua ngrok lúc dev,
# domain thật lúc deploy) — phải khớp chính xác với 1 URI đã đăng ký trong Google Console.
GOOGLE_DRIVE_CALLBACK_URL=""

# Claude API (console.anthropic.com) — dùng cho AI đối chiếu tiến độ file/thực tế, tổng kết 8PM,
# tư vấn chủ nhà (AiService) và phân tích file tiến độ import (ImportScheduleService).
ANTHROPIC_API_KEY=""

# Telegram Bot (kênh thông báo song song với push) — tạo bot qua @BotFather trên Telegram, lấy
# token + username, rồi đăng ký webhook 1 lần:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://api.homee.cristhedev.com/telegram/webhook"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Email mời thành viên (Resend — https://resend.com, xác minh domain gửi). Trống thì không gửi email.
RESEND_API_KEY=""
MAIL_FROM="Nhật Ký Thi Công <noreply@homee.cristhedev.com>"
# Link trong email mời (trang tải app / TestFlight).
APP_DOWNLOAD_URL=""

# Trang quản trị https://<api>/admin — email (tài khoản đăng ký bằng email + mật khẩu) được vào, phân tách bằng dấu phẩy.
ADMIN_EMAILS=""
